[gui]

theme/default_font_antialiasing=1
theme/default_font_hinting=2
theme/default_font_subpixel_positioning=1
theme/default_font_multichannel_signed_distance_field=false
theme/default_font_generate_mipmaps=false

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=false
environment/defaults/default_clear_color=Color(0.078, 0.204, 0.392, 1)
